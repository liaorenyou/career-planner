{
  "name": "@local/career-planner",
  "version": "1.0.0",
  "description": "升学生涯规划插件：抓取课程表/作业/聊天记录，以升学就业为导向排每天的计划，联网研究目标与院校信息，QQ/微信早八点自动推送，并带一个可视化面板。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "examples"
  ],
  "icon": "icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "career",
    "planner",
    "study-plan",
    "qq",
    "wechat"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    }
  },
  "license": "MIT"
}
